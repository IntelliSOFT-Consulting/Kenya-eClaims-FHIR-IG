
CodeSystem: CoverageTypeCS
Id: coverage-type-cs
Title: "Coverage Type Code System"
Description: "Codes for the type of insurance coverage (MOH-Kenya OCL: COVERAGE-TYPE)"
* ^url = "https://ilm-hie.dha.go.ke/ocl/orgs/MOH-KENYA/CodeSystem/COVERAGE-TYPE"
* ^status = #active
* ^content = #complete
* #MEDICAL "Medical"
* #DENTAL "Dental"
* #VISION "Vision"
* #PHARMACY "Pharmacy"
* #ACCIDENT "Accident"
* #OCCUPATIONAL "Occupational"
* #TRAVEL "Travel"


